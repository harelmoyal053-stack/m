# מסד נתונים: מקומית קובץ SQLite; בענן — Turso (libsql://...)
DATABASE_URL=file:local.db
DATABASE_AUTH_TOKEN=

# תוצאות ולוח משחקים — מפתח חינמי מ-https://www.football-data.org/client/register
FOOTBALL_DATA_API_KEY=

# יחסי הימורים לקביעת האנדרדוג — מפתח חינמי מ-https://the-odds-api.com (לא חובה)
ODDS_API_KEY=

# קוד הצטרפות התחלתי (אפשר גם להגדיר במסך הניהול)
GROUP_CODE=

# סוד לקריאה ל-/api/cron/sync משירות cron חיצוני (לא חובה)
CRON_SECRET=
